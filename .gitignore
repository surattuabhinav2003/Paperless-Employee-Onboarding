# --- secrets and local configuration ---
.env
.env.*
!.env.example
!.env.deploy.example
backend/src/main/resources/application-local.properties

# --- uploaded documents (never commit candidate data) ---
# Anchored with a leading slash. Unanchored, "storage/" matched every directory
# of that name at any depth - including the Java package
# com.cloudfuze.onboarding.storage, which was therefore never committed and
# would have failed the build on a fresh clone.
/storage/
/backend/storage/
/backend/build/

# --- Java / Maven ---
target/
*.class
*.jar
!backend/.mvn/wrapper/maven-wrapper.jar
*.log
hs_err_pid*

# --- Node / Vite ---
node_modules/
dist/
dist-ssr/
.vite/
coverage/
npm-debug.log*
yarn-error.log*

# --- IDE / OS ---
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Windows null-device artifact
nul
