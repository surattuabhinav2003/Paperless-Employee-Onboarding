# Frontend environment (Vite). Copy to .env.local for local overrides.

# Where the API lives. Leave unset in development: /api is proxied to the
# backend by vite.config.js. Set it when the API is on another origin.
# VITE_API_BASE_URL=https://api.cloudfuze.com/api

# Backend target for the development proxy.
VITE_API_PROXY_TARGET=http://localhost:8080
