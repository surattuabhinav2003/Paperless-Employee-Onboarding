# =====================================================================
# HR Onboarding Portal - server deployment template
#
# Copy to .env NEXT TO docker-compose.prod.yml on the server, fill it in,
# and never commit it:
#
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build
#
# The seven values marked REQUIRED have no default. Compose refuses to
# start without them rather than booting something half-configured - an
# invitation pointing at localhost, or a console any employee can open.
# =====================================================================

# ---------------------------- Database -------------------------------
POSTGRES_DB=cloudfuze_onboarding
POSTGRES_USER=cloudfuze
# REQUIRED. openssl rand -base64 24
POSTGRES_PASSWORD=

# ------------------------------ Secrets -------------------------------
# REQUIRED. 32 characters minimum: openssl rand -base64 48
# Changing it later signs every HR user out and makes the recoverable copy
# of existing portal links unreadable to HR. Candidates' links keep working.
JWT_SECRET=

# ---------------------------- Addresses -------------------------------
# REQUIRED. The address a candidate opens on their phone - this is what
# every invitation link is built from. Include the port if you publish one.
FRONTEND_URL=https://onboarding-dev.cloudfuze.com

# The port the site is published on. 80 unless something else already
# has it, or unless a reverse proxy in front terminates TLS.
WEB_PORT=80
# Loopback-only, for curling the API on the server. Not reachable outside.
BACKEND_PORT=8080

# ------------------------ Microsoft sign-in ---------------------------
AZURE_TENANT_ID=66d8848d-26b6-4147-8124-127624d7b3a6
AZURE_CLIENT_ID=94567b93-d905-43f6-9648-63a98eb1429a
# Only needed when EMAIL_PROVIDER=graph.
AZURE_CLIENT_SECRET=
# REQUIRED. Comma-separated. Anyone in the tenant not on this list is
# refused. Left empty, every employee who signs in becomes an HR user and
# can read candidates' identity documents.
AZURE_HR_EMAILS=

# The app registration must also list FRONTEND_URL as a SPA redirect URI,
# or Microsoft sign-in fails with AADSTS50011. Entra ID accepts https for
# a real hostname and http only for localhost - so a dev server reached
# over plain http cannot use Microsoft sign-in at all, and the seeded
# password login below is the way in until it has a certificate.

# ------------------------------- Email --------------------------------
# log  = write the message to the container log, send nothing (safe default)
# smtp = deliver through the MAIL_* settings
# graph = send as EMAIL_GRAPH_SENDER through Microsoft Graph. Needs the
#         Mail.Send APPLICATION permission with admin consent on the app
#         registration - without it Graph returns 403 and nothing sends.
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=onboarding@cloudfuze.com
EMAIL_FROM_NAME=Neutara Onboarding
EMAIL_REPLY_TO=Aditya.Rompella@neutara.com
EMAIL_SUPPORT_CONTACT=Aditya.Rompella@neutara.com
# Where HR notifications go - a document submitted, an offer signed.
EMAIL_HR_NOTIFY=Aditya.Rompella@neutara.com
EMAIL_HR_NOTIFY_NAME=Neutara HR
# Blind copy of everything sent to candidates. Verification codes are
# deliberately excluded: a code plus the invitation link is full access to
# somebody's identity documents.
EMAIL_ARCHIVE=Aditya.Rompella@neutara.com
# Mailbox Graph sends as. Only used when EMAIL_PROVIDER=graph.
EMAIL_GRAPH_SENDER=

MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ---------------------------- First login -----------------------------
SEED_ENABLED=true
SEED_HR_EMAIL=admin@cloudfuze.com
# Leave blank and a strong password is generated and printed once at
# startup: docker compose -f docker-compose.prod.yml logs backend | grep -i password
SEED_HR_PASSWORD=
# REQUIRED. Comma-separated addresses that get the ADMIN role, which is
# what Admin settings and record deletion are gated on. The application's
# built-in default still lists an address from a previous company.
SEED_ADMIN_EMAILS=Abhinav.surattu@cloudfuze.com
SEED_SAMPLE_CANDIDATES=false

# ------------------------------- Other --------------------------------
# The one-time code a candidate needs before their documents open.
PORTAL_VERIFICATION_ENABLED=true
RATE_LIMIT_ENABLED=true
# Domains an NDA + NOC may be sent to.
NOC_RECIPIENT_DOMAINS=cloudfuze.com,neutara.com
PORTAL_TOKEN_TTL=14d
TZ=Asia/Kolkata
LOG_LEVEL=INFO
