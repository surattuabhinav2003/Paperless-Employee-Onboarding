# =====================================================================
# CloudFuze HR Onboarding Portal - environment template
# Copy to .env (never commit .env) and export these before starting the
# backend, or set them in your deployment platform.
# =====================================================================

# ---------------------------- PostgreSQL -----------------------------
POSTGRES_DB=cloudfuze_onboarding
POSTGRES_USER=cloudfuze
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/cloudfuze_onboarding
DATABASE_USERNAME=cloudfuze
DATABASE_PASSWORD=change-me
# update | validate | none  (use validate once migrations own the schema)
JPA_DDL_AUTO=update

# ------------------------ HR authentication --------------------------
# Required. Minimum 32 characters: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=8h
# Encrypts the recoverable copy of candidate portal links (blank = derive from JWT_SECRET).
# Rotating this makes existing links unreadable to HR; candidates' links keep working.
PORTAL_TOKEN_ENCRYPTION_SECRET=

# --------------------------- Portal links ----------------------------
FRONTEND_URL=http://localhost:5173
PORTAL_PATH=/upload/{token}
PORTAL_TOKEN_TTL=14d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------ Email --------------------------------
# log = write the invitation to the application log (development)
# smtp = deliver through the MAIL_* settings below
EMAIL_PROVIDER=log
EMAIL_FROM_ADDRESS=onboarding@cloudfuze.com
EMAIL_FROM_NAME=CloudFuze Onboarding
EMAIL_REPLY_TO=hr@cloudfuze.com
EMAIL_SUPPORT_CONTACT=hr@cloudfuze.com
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ----------------------------- Storage -------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
MAX_FILE_SIZE=10MB
MAX_FILE_SIZE_BYTES=10485760

# --------------------------- SignatureOne ----------------------------
# mock = in-memory provider behind the same interface (development)
# http = real SignatureOne REST API (needs base URL + credentials)
SIGNATUREONE_PROVIDER=mock
SIGNATUREONE_BASE_URL=
SIGNATUREONE_API_KEY=
SIGNATUREONE_ACCOUNT_ID=
SIGNATUREONE_WEBHOOK_SECRET=
SIGNATUREONE_RETURN_URL=

# --------------------------- Development -----------------------------
SEED_ENABLED=true
SEED_HR_EMAIL=admin@cloudfuze.com
# Leave blank to have a strong password generated and printed once at startup
SEED_HR_PASSWORD=
SEED_SAMPLE_CANDIDATES=false
LOG_LEVEL=INFO

# ---------------------------- Frontend -------------------------------
# Only needed when the API is not reachable on the same origin as the UI.
# VITE_API_BASE_URL=https://api.cloudfuze.com/api
VITE_API_PROXY_TARGET=http://localhost:8080
